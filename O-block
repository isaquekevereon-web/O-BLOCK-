local function alive(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end
local function headOf(p)
    local character = p.Character
    if not character or (ignoreDead and not alive(character)) then return nil end
    return character:FindFirstChild("Head")
end
local function targetHead()
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local best, distance = nil, fovRadius
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local head = headOf(p)
            if head then
                local screen, visible = Camera:WorldToViewportPoint(head.Position)
                if visible and screen.Z > 0 then
                    local d = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                    if d < distance then
                        best, distance = head, d
                    end
                end
            end
        end
    end
    return best
end
local function removeESP(p)
    if highlights[p] then highlights[p]:Destroy(); highlights[p] = nil end
    if bars[p] then bars[p]:Destroy(); bars[p] = nil end
end
local function updateESP(p)
    local character = p.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not enabledESP or not humanoid or not root or (ignoreDead and humanoid.Health <= 0) then
        removeESP(p)
        return
    end
    if not highlights[p] or highlights[p].Adornee ~= character then
        removeESP(p)
        local h = Instance.new("Highlight")
        h.Name = "OBLOCK_Box"
        h.Adornee = character
        h.FillTransparency = 1
        h.OutlineColor = Color3.fromRGB(190, 90, 255)
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = gui
        highlights[p] = h
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "OBLOCK_Health"
        billboard.Adornee = root
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.fromOffset(8, 75)
        billboard.StudsOffset = Vector3.new(2.7, 0, 0)
        billboard.Parent = gui
        local back = Instance.new("Frame")
        back.Size = UDim2.fromScale(1, 1)
        back.BackgroundColor3 = Color3.fromRGB(80, 20, 25)
        back.Parent = billboard
        local fill = Instance.new("Frame")
        fill.Name = "Fill"
        fill.AnchorPoint = Vector2.new(0, 1)
        fill.Position = UDim2.fromScale(0, 1)
        fill.Size = UDim2.fromScale(1, 1)
        fill.BackgroundColor3 = Color3.fromRGB(65, 230, 110)
        fill.BorderSizePixel = 0
        fill.Parent = back
        bars[p] = billboard
    end
    local fill = bars[p]:FindFirstChild("Fill", true)
    if fill then
        local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
        fill.Size = UDim2.fromScale(1, ratio)
        fill.BackgroundColor3 = Color3.fromRGB(math.floor(255 * (1-ratio)), math.floor(230 * ratio), 60)
    end
end
local elapsed = 0
connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
    Camera = workspace.CurrentCamera
    if not Camera then return end
    local size = Camera.ViewportSize
    fovCircle.Visible = showFOV
    fovCircle.Size = UDim2.fromOffset(fovRadius * 2, fovRadius * 2)
    fovCircle.Position = UDim2.fromOffset(size.X / 2, size.Y / 2)
    if enabledAim then
        local head = targetHead()
        if head then
            local origin = Camera.CFrame.Position
            local desired = CFrame.lookAt(origin, head.Position)
            Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(smoothness, 0, 1))
        end
    end
    elapsed = elapsed + dt
    if elapsed > 0.12 then
        elapsed = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then updateESP(p) end
        end
    end
end)
connections[#connections + 1] = Players.PlayerRemoving:Connect(removeESP)
local function cleanup()
    for _, c in ipairs(connections) do c:Disconnect() end
    for p in pairs(highlights) do removeESP(p) end
    gui:Destroy()
end
_G.OBLOCK_PVP_CLEANUP = cleanup
close.MouseButton1Click:Connect(cleanup)
